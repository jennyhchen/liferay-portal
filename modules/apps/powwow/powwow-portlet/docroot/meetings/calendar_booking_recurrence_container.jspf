--%>

<%
int weekStartsOn = GetterUtil.getInteger(portletPreferences.getValue("weekStartsOn", null), 0);
Recurrence recurrence = null;
TimeZone userTimeZone = TimeZone.getTimeZone(user.getTimeZoneId());
TimeZone calendarBookingTimeZone = userTimeZone;
java.util.Calendar nowJCalendar = CalendarFactoryUtil.getCalendar(calendarBookingTimeZone);

long startTime = BeanPropertiesUtil.getLong(calendarBooking, "startTime", nowJCalendar.getTimeInMillis());
java.util.Calendar startTimeJCalendar = JCalendarUtil.getJCalendar(startTime, calendarBookingTimeZone);

int count = 7;
String exceptionDatesString = StringPool.BLANK;
Frequency frequency = null;
int interval = 0;
PositionalWeekday positionalWeekday = new PositionalWeekday(startTimeJCalendar);
Weekday startTimeWeekday = Weekday.getWeekday(startTimeJCalendar);
java.util.Calendar untilJCalendar = startTimeJCalendar;
List<Weekday> weekdays = new ArrayList<Weekday>();

boolean afterChecked = true;
boolean onChecked = false;

if (calendarBooking != null) {
	recurrence = RecurrenceUtil.inTimeZone(calendarBooking.getRecurrenceObj(), startTimeJCalendar, calendarBookingTimeZone);
}

if (recurrence != null) {
	if (recurrence.getCount() > 1) {
		count = recurrence.getCount();
	}

	frequency = recurrence.getFrequency();
	interval = recurrence.getInterval();

	if (recurrence.getPositionalWeekday() != null) {
		positionalWeekday = recurrence.getPositionalWeekday();
	}

	if (recurrence.getUntilJCalendar() != null) {
		untilJCalendar = recurrence.getUntilJCalendar();
	}

	weekdays = recurrence.getWeekdays();

	if (count > 0) {
		afterChecked = true;
	}

	if (recurrence.getUntilJCalendar() != null) {
		onChecked = true;
	}

	StringBundler sb = new StringBundler();

	List<java.util.Calendar> exceptionJCalendars = recurrence.getExceptionJCalendars();

	Iterator<java.util.Calendar> iterator = exceptionJCalendars.iterator();

	while (iterator.hasNext()) {
		java.util.Calendar exceptionJCalendar = iterator.next();

		sb.append(exceptionJCalendar.getTimeInMillis());

		if (iterator.hasNext()) {
			sb.append(StringPool.COMMA);
		}
	}

	exceptionDatesString = sb.toString();
}
%>

<div class="calendar-portlet-recurrence-container hide" id="<portlet:namespace />recurrenceContainer">
	<table>
		<aui:input name="exceptionDates" type="hidden" value="<%= exceptionDatesString %>" />
		<aui:input name="recurrenceInterval" type="hidden" value="<%= interval %>" />

		<tbody>
			<tr>
				<th class="calendar-portlet-recurrence-title">
					<liferay-ui:message key="repeat" />:
				</th>
				<td class="calendar-portlet-recurrence-content">
					<aui:select label="" name="frequency">

						<%
						String yearly = Frequency.YEARLY.getValue();

						for (Frequency curFrequency : Frequency.values()) {
							if(curFrequency.getValue().equals(yearly)) continue;
						%>

							<aui:option selected="<%= (frequency == curFrequency) %>" value="<%= curFrequency.getValue() %>"><%= LanguageUtil.get(request.getLocale(), StringUtil.toLowerCase(curFrequency.getValue())) %></aui:option>

						<%
						}
						%>

					</aui:select>
				</td>
			</tr>
		</tbody>
		<tbody class="calendar-portlet-interval-view" id="<portlet:namespace />intervalContainer">
			<tr>
				<th class="calendar-portlet-recurrence-title">
					<liferay-ui:message key="repeat-every" />:
				</th>
				<td class="calendar-portlet-recurrence-content">
					<aui:select label="" name="interval">
					</aui:select>

					<span id="<portlet:namespace />intervalLabel"></span>
				</td>
			</tr>
		</tbody>
		<tbody class="calendar-portlet-interval-view <%= (frequency == Frequency.WEEKLY) ? "" : "hide" %>" id="<portlet:namespace />view<%= Frequency.WEEKLY %>">
			<tr>
				<th class="calendar-portlet-recurrence-title">
					<liferay-ui:message key="repeat-on" />:
				</th>
				<td class="calendar-portlet-recurrence-content calendar-recurrence-weekday-checkbox">

					<%
					Weekday[] weekdaysArray = Weekday.values();

					Collections.rotate(Arrays.asList(weekdaysArray), -weekStartsOn);
					%>

					<aui:field-wrapper inlineField="<%= true %>" label="">

						<%
						for (Weekday weekday : weekdaysArray) {
							String weekdayLabel = "weekday." + weekday.getValue();
						%>

							<aui:input checked="<%= weekdays.contains(weekday) %>" id="<%= weekday.getValue() %>" label="<%= weekdayLabel %>" name="weekdays" type="checkbox" value="<%= weekday.getValue() %>" />

						<%
						}
						%>

						<aui:input name="weekdaysCheckbox" type="hidden" value="<%= startTimeWeekday.getValue() %>" />
					</aui:field-wrapper>
				</td>
			</tr>
		</tbody>
		<tbody class="calendar-portlet-interval-view <%= ((frequency == Frequency.MONTHLY) || (frequency == Frequency.YEARLY)) ? "" : "hide" %>" id="<portlet:namespace />viewPositionInMonth">
			<tr>
				<th class="calendar-portlet-recurrence-title">
					<liferay-ui:message key="repeat-on" />:
				</th>
				<td class="calendar-portlet-recurrence-content calendar-recurrence-month-radio">
					<aui:input checked="<%= ListUtil.isEmpty(weekdays) %>" inlineField="<%= true %>" label="day-of-the-month" name="repeatOnWeekday" type="radio" value="false" />

					<aui:input checked="<%= ListUtil.isNotEmpty(weekdays) %>" inlineField="<%= true %>" label="day-of-the-week" name="repeatOnWeekday" type="radio" value="true" />

					<div class='<%= ListUtil.isEmpty(weekdays) ? "hide" : StringPool.BLANK %>' id="<portlet:namespace />viewPositionalWeekday">

						<%
						Weekday weekday = positionalWeekday.getWeekday();
						%>

						<aui:input checked="<%= positionalWeekday.getPosition() == -1 %>" label="repeat-on-month-last-day-of-the-week" name="lastPosition" type="checkbox" />

						<aui:input name="position" type="hidden" value="<%= positionalWeekday.getPosition() %>" />

						<aui:input name="weekday" type="hidden" value="<%= weekday.getValue() %>" />
					</div>
				</td>
			</tr>
		</tbody>
		<tbody class="calendar-portlet-interval-view" id="<portlet:namespace />viewStopRepeating">
			<tr>
				<th class="calendar-portlet-recurrence-title">
					<liferay-ui:message key="stop-repeating" />:
				</th>
				<td class="calendar-portlet-recurrence-content">
					<aui:field-wrapper cssClass="calendar-portlet-recurrence-limit" label="">
						<aui:input checked="<%= afterChecked %>" label="<%= StringPool.BLANK %>" name="ends" type="radio" value="after" />

						<label><liferay-ui:message key="after" /></label>

						<aui:input autoFocus="false" disabled="<%= !afterChecked %>" label="<%= StringPool.BLANK %>" name="count" type="number" min="2" max="50" value="<%= afterChecked ? count : StringPool.BLANK %>">
							<aui:validator name="max">50</aui:validator>
							<aui:validator name="min">2</aui:validator>
						</aui:input>

						<label><liferay-ui:message key="occurrences" /></label>
					</aui:field-wrapper>

					<aui:field-wrapper cssClass="calendar-portlet-field-date calendar-portlet-recurrence-limit" label="">
						<aui:input checked="<%= onChecked %>" label="<%= StringPool.BLANK %>" name="ends" type="radio" value="on" />

						<div class="calendar-portlet-field-datepicker clearfix">
							<label><liferay-ui:message key="on" /></label>

							<liferay-ui:input-date
								dayParam="untilDateDay"
								dayValue="<%= untilJCalendar.get(java.util.Calendar.DATE) %>"
								disabled="<%= !onChecked %>"
								monthParam="untilDateMonth"
								monthValue="<%= untilJCalendar.get(java.util.Calendar.MONTH) %>"
								name="untilDate"
								yearParam="untilDateYear"
								yearValue="<%= untilJCalendar.get(java.util.Calendar.YEAR) %>"
							/>
							<div class="form-validator-stack help-block"
								id="<portlet:namespace />untilDateError">
								<div role="alert" class="required"></div>
							</div>
						</div>
					</aui:field-wrapper>
				</td>
			</tr>
		</tbody>
		<tbody class="calendar-portlet-interval-view">
			<tr>
				<th class="calendar-portlet-recurrence-title">
					<liferay-ui:message key="summary" />:
				</th>
				<td class="calendar-portlet-recurrence-content">
					<span class="calendar-portlet-recurrence-summary" id="<portlet:namespace />summaryPreview">
						<liferay-ui:message key="none" />
					</span>
				</td>
			</tr>
		</tbody>
	</table>
</div>

<aui:script use="liferay-util-window,liferay-meeting-calendar-recurrence-dialog,aui-io-request,aui-base">
	var meetingRecurrenceContainerNode = A.one('#<portlet:namespace />recurrenceContainer');
	var meetingRepeatCheckboxNode = A.one('#<portlet:namespace />repeat');
	var meetingSummaryNode = A.one('#<portlet:namespace />summary');
	var untilDateDatePicker = Liferay.component('<%= renderResponse.getNamespace() + HtmlUtil.getAUICompatibleId("untilDateDatePicker") %>');
	var untilDateError = A.one('#<portlet:namespace />untilDateError');
	var untilDateExceededMaxOccurrences = false;

	var meetingRecurrenceDialogController = new Liferay.MeetingRecurrenceDialogController(
		{
			container: '#<portlet:namespace />recurrenceContainer',
			dayOfWeekInput: '#<portlet:namespace />weekday',
			frequencySelect: '#<portlet:namespace />frequency',
			recurrenceInterval: '#<portlet:namespace />recurrenceInterval',
			intervalSelect: '#<portlet:namespace />interval',
			lastPositionCheckbox: '#<portlet:namespace />lastPosition',
			limitCountInput: '#<portlet:namespace />count',
			limitCountRadioButton: '[name=<portlet:namespace />ends][value=after]',
			limitDateDatePicker: Liferay.component('<%= renderResponse.getNamespace() + HtmlUtil.getAUICompatibleId("untilDateDatePicker") %>'),
			limitDateRadioButton: '[name=<portlet:namespace />ends][value=on]',
			monthlyRecurrenceOptions: '#<portlet:namespace />viewPositionInMonth',
			positionalDayOfWeekOptions: '#<portlet:namespace />viewPositionalWeekday',
			positionInput: '#<portlet:namespace />position',
			repeatCheckbox: '#<portlet:namespace />repeat',
			repeatOnDayOfMonthRadioButton: '[name=<portlet:namespace />repeatOnWeekday][value=false]',
			repeatOnDayOfWeekRadioButton: '[name=<portlet:namespace />repeatOnWeekday][value=true]',
			startDateDatePicker: Liferay.component('<portlet:namespace />startDateDatePicker'),
			startTimeDayOfWeekInput: '#<portlet:namespace />weekdaysCheckbox',
			weeklyRecurrenceOptions: '#<portlet:namespace />view<%= Frequency.WEEKLY %>'

		}
	);

	var getMeetingRecurrenceDialogTitle = function() {
		var summary = meetingRecurrenceDialogController.get('summary');

		return '<liferay-ui:message key="repeat" /> ' + (summary.charAt(0).toLowerCase() + summary.slice(1));
	};

	window.<portlet:namespace />meetingRecurrenceDialog;

	window.<portlet:namespace />openMeetingRecurrenceDialog = function(visible) {
		meetingRecurrenceContainerNode.toggle(visible);

		window.<portlet:namespace />meetingRecurrenceDialog = Liferay.Util.Window.getWindow(
			{
				dialog: {
					after:{
						visibleChange: function(event) {
							meetingRecurrenceContainerNode.toggle(event.newVal);

							window.<portlet:namespace />updateSummaries();
						}
					},
					bodyContent: meetingRecurrenceContainerNode,
					centered: true,
					height: 600,
					id: '<portlet:namespace />meetingRecurrenceDialog',
					modal: true,
					render: '#<portlet:namespace />fm',
					toolbars: {
						footer: [
							{
								label: '<liferay-ui:message key="done" />',
								on: {
									click: function() {
										window.<portlet:namespace />closeDialogButton();
									}
								}
							}
						]
					},
					visible: visible,
					width: 600
				},
				title: getMeetingRecurrenceDialogTitle()
			}
		);
	};

	A.one('body').on('key', function(event) {
		if (window.<portlet:namespace />meetingRecurrenceDialog) {
			window.<portlet:namespace />meetingRecurrenceDialog.once('visibleChange', function(event) {
				var limitCountInputValue = meetingRecurrenceDialogController.get('limitCountInput').val();

				if (limitCountInputValue < 2 || limitCountInputValue > 50) {
					if (event.prevVal === true) {
						event.newVal = true;
					}
				}
			});
		};
	}, 'esc');

	meetingRepeatCheckboxNode.on(
		'change',
		function(event) {
			var checked = event.currentTarget.get('checked');

			if (!checked) {
				meetingSummaryNode.empty();
			}
			else {
				window.<portlet:namespace />updateSummaries();
			}

			<portlet:namespace />openMeetingRecurrenceDialog(checked);
		}
	);

	meetingSummaryNode.on(
		'click',
		function(event) {
			<portlet:namespace />openMeetingRecurrenceDialog(true);

			event.halt();
		}
	);

	meetingRecurrenceDialogController.on(
		'recurrenceChange',
		function(event) {
			window.<portlet:namespace />updateSummaries();
			window.<portlet:namespace />resetRecurrenceDialog();
		}
	);

	window.<portlet:namespace />updateSummary = function(element) {
		var previewNode = A.one(element);

		if (previewNode) {
			previewNode.html(meetingRecurrenceDialogController.get('summary'));
		}
	};

	window.<portlet:namespace />updateSummaries = function() {
		window.<portlet:namespace />updateSummary(meetingSummaryNode);
		window.<portlet:namespace />updateSummary('#<portlet:namespace />summaryPreview');

		if (window.<portlet:namespace />meetingRecurrenceDialog) {
			window.<portlet:namespace />meetingRecurrenceDialog.titleNode.html(getMeetingRecurrenceDialogTitle());

			window.<portlet:namespace />meetingRecurrenceDialog.fillHeight(window.<portlet:namespace />meetingRecurrenceDialog.bodyNode);
		}
	}

	<c:if test="<%= recurring %>">
		window.<portlet:namespace />updateSummaries();
	</c:if>

	A.one('body').on('key', function(event) {
		window.<portlet:namespace />closeDialogKey();
	}, 'esc');

	untilDateDatePicker.after('selectionChange', function(event){
		window.<portlet:namespace />validateUntilDate();
	});

	window.<portlet:namespace />validateUntilDate = function() {
		A.io.request(
			'<%=checkMaxOccurrenceURL.toString()%>',
			{
				method : 'GET',
				dataType: 'json',
				form : {
					id: '<portlet:namespace />fm'
				},
				on: {
					success: function() {
						var response = this.get('responseData');
						var untilDateErrorDiv = A.one('#<portlet:namespace />untilDateError div');

						if(!response.valid){
							untilDateError.show();
							var errorText = response.errorMessage
							untilDateErrorDiv.setHTML(errorText);
							untilDateExceededMaxOccurrences = true;
						}
						else {
							untilDateErrorDiv.setHTML('');
							untilDateError.hide();
							untilDateExceededMaxOccurrences = false;
						}
					}
				}
			}
		);
	}

	window.<portlet:namespace />closeDialogButton = function() {
		var limitType = meetingRecurrenceDialogController.get('limitType');
		if(limitType === 'after'){
			var limitCountInputValue = meetingRecurrenceDialogController.get('limitCountInput').val();
			if (limitCountInputValue >= 2 && limitCountInputValue <= 50) {
				window.<portlet:namespace />meetingRecurrenceDialog.hide();
			}
		}
		else {
			if (!untilDateExceededMaxOccurrences) {
				window.<portlet:namespace />meetingRecurrenceDialog.hide();
			}
		}
	}

	window.<portlet:namespace />closeDialogKey = function() {
		if (window.<portlet:namespace />meetingRecurrenceDialog) {
			window.<portlet:namespace />meetingRecurrenceDialog.once('visibleChange', function(event) {
				var limitCountInputValue = meetingRecurrenceDialogController.get('limitCountInput').val();
				var limitType = meetingRecurrenceDialogController.get('limitType');

				if(limitType === 'after'){
					if (limitCountInputValue < 2 || limitCountInputValue > 50) {
						if (event.prevVal === true) {
							event.newVal = true;
						}
					}
				}
				else if (untilDateExceededMaxOccurrences) {
					if (event.prevVal === true) {
						event.newVal = true;
					}
				}

			});
		};
	}

	window.<portlet:namespace />resetRecurrenceDialog = function() {
		var limitType = meetingRecurrenceDialogController.get('limitType');

		if(limitType == 'on'){
			if(A.one('#<portlet:namespace />countHelper')){
				A.one('#<portlet:namespace />countHelper div').setHTML('');
			}
			A.one('#<portlet:namespace />count').val(<%= count %>);
		}

		window.<portlet:namespace />validateUntilDate();
		untilDateExceededMaxOccurrences = false;
	}
</aui:script>
